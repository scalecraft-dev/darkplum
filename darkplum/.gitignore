# Terraform — never commit state (contains secrets: DB passwords, endpoints,
# account IDs) or local provider caches. The .lock.hcl IS committed.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files may hold secrets; keep the example only.
*.tfvars
!*.tfvars.example

# Written per install by `darkplum init` (names the customer's own state bucket).
terraform/aws/backend.tf
terraform/aws/backend.tf.bak
terraform/aws/*.tfvars.bak
# Private kubeconfig every darkplum kube command regenerates and validates.
terraform/*/.darkplum/

# Build output
/bin/

# OS cruft
.DS_Store

# Scratch file the old make-based destroy used (kept ignored for old checkouts).
terraform/aws/.destroy-snapshot
