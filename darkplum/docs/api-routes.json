  {
    "service": "gateway",
    "method": "GET",
    "path": "/health",
    "auth": "public",
    "surface": "machine",
    "reason": "Kubernetes probe and operator diagnostics (routing, policy, classifier state); the api's /health is what the browser reaches"
  },
  {
    "service": "gateway",
    "method": "GET",
    "path": "/v1/models",
    "auth": "api_key",
    "surface": "machine",
    "reason": "Discovered-model list for the api's catalog sync (service key) and for SDK callers with a user key; the browser uses the api's /v1/models"
  },
  {
    "service": "gateway",
    "method": "POST",
    "path": "/v1/chat/completions",
    "auth": "api_key",
    "surface": "machine",
    "reason": "Inference endpoint; the browser reaches it through the api proxy (/v1/chat/completions on the api), SDKs call it with a user key"
  },
  {
    "service": "gateway",
    "method": "POST",
    "path": "/v1/routing/dryrun",
    "auth": "api_key",
    "surface": "machine",
    "reason": "Called by the api on behalf of the admin Test-a-prompt panel (POST /api/v1/model-aliases/:alias/test) with the service key"
  },
  {
    "service": "gateway",
    "method": "GET",
    "path": "/v1/policy/effective",
    "auth": "service",
    "surface": "machine",
    "reason": "Single effective-policy implementation, consulted by the api for every effective/preview/me view with the service key"
  },
  {
    "service": "gateway",
    "method": "POST",
    "path": "/v1/policy/effective",
    "auth": "service",
    "surface": "machine",
    "reason": "Preview counterpart of GET /v1/policy/effective, consulted by the api's routing-policy impact-preview endpoints (POST .../users/:id/routing-policy/preview, .../api-keys/:id/routing-policy/preview) so preview and real save share the one gateway merge implementation"
  },
  {
    "service": "gateway",
    "method": "POST",
    "path": "/v1/policy/impact",
    "auth": "service",
    "surface": "machine",
    "reason": "Org-wide lock-out check consulted by the api's PUT /api/v1/routing-policy before it writes: re-merges every principal with an explicit policy row under the proposed org policy in one call, so the org PUT refuses (409) a lock-out exactly like the user/key PUTs do, with the one gateway merge implementation"
  },
  {
    "service": "gateway",
    "method": "POST",
    "path": "/v1/policy/refresh",
    "auth": "service",
    "surface": "machine",
    "reason": "Reload the policy snapshot now. The api calls it after every policy-shaped write (model enable/disable, alias, org and per-principal policy) so chat enforcement, effective-policy reads and lock-out previews reflect the write immediately instead of up to POLICY_REFRESH_SECONDS later"
  },
  {
    "service": "gateway",
    "method": "POST",
    "path": "/v1/providers/:vendor/verify",
    "auth": "service",
    "surface": "machine",
    "reason": "Called only by the api, with the service key, to verify and activate a vendor key an administrator installs from Admin > Models"
  },
  {
    "service": "gateway",
    "method": "POST",
    "path": "/v1/providers/:vendor/refresh",
    "auth": "service",
    "surface": "machine",
    "reason": "Called only by the api, with the service key, to verify and activate a vendor key an administrator installs from Admin > Models"
  }
