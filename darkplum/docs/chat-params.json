        "anthropic": "forward",
        "bedrock": "forward",
        "openai": "forward",
        "openaicompat": "forward"
      },
      "strict": {
        "anthropic": "forward",
        "bedrock": "forward",
        "openai": "forward",
        "openaicompat": "forward"
      },
