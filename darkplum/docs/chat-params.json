      "when": "text",
      "backends": {
        "anthropic": "accept-default",
        "bedrock": "accept-default",
        "openai": "accept-default",
        "openaicompat": "accept-default"
      },
      "strict": {
        "anthropic": "accept-default",
        "bedrock": "accept-default",
        "openai": "accept-default",
        "openaicompat": "accept-default"
      },
